include LICENSE NOTICE README.md CONTRIBUTING.md SECURITY.md start.command
recursive-include assets *.svg
recursive-include docs *.md *-LICENSE.txt
include docs/deployment-guide-preview.png docs/workbench-preview.png
recursive-include examples *.py
recursive-include tests *.py
recursive-include tools *.py
recursive-include paper *.tex *.md
recursive-include knowledge *.md *.jsonl *.pdf
recursive-include .github *.yml
global-exclude __pycache__ *.py[cod] .DS_Store
